# Local credentials; never commit or share this file.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MEP_OPENAI_MODEL=gpt-6-luna
MEP_ANTHROPIC_MODEL=claude-haiku-5-5

# Weekly report uses this operator-selected service automatically.
# Switching provider sends source notes to that provider; check access and terms first.
MEP_REPORT_PROVIDER=Anthropic
MEP_REPORT_MODEL=claude-haiku-5-5

# Optional for Anthropic keys with access to multiple workspaces.
ANTHROPIC_WORKSPACE_ID=

# Optional comparison providers. Set only in your local .env.
GEMINI_API_KEY=
MISTRAL_API_KEY=
MEP_GEMINI_MODEL=gemini-3.5-flash-lite
MEP_MISTRAL_MODEL=mistral-small-2603
